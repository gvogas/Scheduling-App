rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // True when the caller is an active admin, via the syncUsersByUid bridge doc.
    function isAdmin() {
      let bridge = firestore.get(
        /databases/(default)/documents/usersByUid/$(request.auth.uid)
      );
      return isSignedIn()
        && bridge != null
        && bridge.data.role == 'admin'
        && bridge.data.status == 'active';
    }

    // True when the current user's Firestore doc ID shows up in this appointment's
    // employeeIds array.
    function isAssignedToAppointment(appointmentId) {
      let bridge = firestore.get(
        /databases/(default)/documents/usersByUid/$(request.auth.uid)
      );
      let appt = firestore.get(
        /databases/(default)/documents/appointments/$(appointmentId)
      );
      // `status == 'active'` is load-bearing — the bridge doc survives deactivation,
      // so without it a disabled employee keeps reading job photos.
      return isSignedIn()
        && bridge != null
        && appt != null
        && bridge.data.status == 'active'
        && bridge.data.docId in appt.data.employeeIds;
    }

    // ── Appointment images ────────────────────────────────────────────────────
    match /appointments/{appointmentId}/images/{fileName} {

      // Read: admin sees all; assigned employees see their appointments' images.
      allow read: if isAdmin() || isAssignedToAppointment(appointmentId);

      // Admin, OR an assignee of THIS appointment (2026-09-01). It was
      // admin-only because "the upload flow only runs in admin sessions" —
      // which was true, and was the gap: the crew who are actually on site
      // could not photograph what they found, on an app whose whole photo
      // pipeline already existed. The grant is per-appointment, so a
      // technician can only write under a job they are on.
      //
      // contentType is client-set and easy to fake, so these checks are
      // defense in depth; the real defense is the magic-byte trigger
      // (`validateUploadedImage`), which deletes a non-JPEG/PNG object
      // server-side. `firestore.rules` grants the matching row create at the
      // same path.
      allow create: if (isAdmin() || (resource == null
            && isAssignedToAppointment(appointmentId)))
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');

      // Assignees may add evidence, but only admins may replace existing bytes.
      allow update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');

      // Admin only, and deliberately NOT widened with the write above: adding
      // to the record is additive, removing from it is not. A field record is
      // the billable artifact, so a photo must not be quietly deletable by the
      // person whose work it documents. (The old reason given here — that
      // employees can't modify the `pictures` array — is stale: that array is
      // gone.)
      allow delete: if isAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
