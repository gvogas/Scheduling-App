rules_version = '2';

// Role resolution goes through the `usersByUid/{uid}` bridge, kept up to date by
// syncUsersByUid in functions/index.js. Rules can only `get` a doc by its full path,
// and `users` docs have Firestore-generated IDs, so this bridge is how we look up a
// user from just their auth uid.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ─────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userByUid() {
      return get(/databases/$(database)/documents/usersByUid/$(request.auth.uid));
    }

    function userByUidExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usersByUid/$(request.auth.uid));
    }

    function isAdmin() {
      return userByUidExists()
        && userByUid().data.role == 'admin'
        && userByUid().data.status == 'active';
    }

    // True when the person making the request — not the resource being read — is an
    // active user. Checking the caller instead of the resource is what keeps list
    // queries provable.
    function isActiveUser() {
      return userByUidExists()
        && userByUid().data.status == 'active';
    }

    // Returns the current user's Firestore doc ID — we use this to check whether
    // they're in an appointment's employeeIds.
    function myDocId() {
      return userByUid().data.docId;
    }

    // We also check active status here, because deactivating someone doesn't revoke
    // their Auth credential — without this, a disabled employee could keep reading
    // their assigned jobs.
    function isAssignedEmployee(appointmentData) {
      return isActiveUser()
        && myDocId() in appointmentData.employeeIds;
    }

    // Shared by isValidUserData / isValidAppointmentData. Declared at the top
    // level so all the collection validators can reach it — it used to live
    // inside the /users match block, which is why isValidClientData still
    // spells the same check out inline.
    function isBoundedString(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // We don't add a catch-all deny rule here — Firestore already denies by default,
    // and we've seen an explicit one interact oddly with list queries.

    // ── usersByUid (bridge collection) ───────────────────────────────────────
    // Only the syncUsersByUid Cloud Function writes here, via the Admin SDK. Clients
    // can read their own doc, but none of them can write.
    match /usersByUid/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── rateLimits (abuse counters) ──────────────────────────────────────────
    // Admin SDK only, via enforceDurableRateLimit — if a client could read or reset
    // its own counter, it would defeat the brute-force cap on auth routes.
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // Admin-SDK-only idempotency ledger for the 30-minute reminder sweep. If a client
    // could delete an entry, it could force a duplicate reminder.
    match /appointmentReminders/{id} {
      allow read, write: if false;
    }

    // Admin-SDK-only idempotency ledger for the overdue "job finished?" sweep — same
    // posture as appointmentReminders above.
    match /appointmentOverduePrompts/{id} {
      allow read, write: if false;
    }

    // Admin-SDK-only claim ledger that collapses a repeat-series batch into one push
    // per employee per kind — same posture as the ledgers above.
    match /appointmentSeriesNotices/{id} {
      allow read, write: if false;
    }

    // Admin-SDK-only claim ledger that collapses one photo batch's N recount
    // triggers into a single parent write — same posture as the ledgers above.
    // There is no `match /{document=**}` catch-all in this file, so the
    // collection is default-denied without this block; it is stated anyway so
    // every server-owned ledger is visible in one place.
    match /appointmentRecountClaims/{appointmentId} {
      allow read, write: if false;
    }

    // Sibling of the above for client `jobCount`; same server-owned posture.
    match /clientRecountClaims/{clientId} {
      allow read, write: if false;
    }

    // Admin-SDK-only mapping of each tech to their live-activity appointment, owned
    // entirely by the server — a client write here could redirect another tech's card
    // and leak a client's address.
    match /liveActivityCards/{employeeDocId} {
      allow read, write: if false;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    // Admins can read everything; active employees can see active peers (for pickers
    // and display); and anyone can read their own doc by uid — which is how an
    // `invited` person reaches the setup screen. Only an admin can write: account
    // activation happens server-side via completeEmployeeSetup, so there's no way
    // for a client to self-activate.
    match /users/{userId} {
      // The active-peers clause checks the caller (via the usersByUid bridge) rather
      // than the resource, which keeps list queries provable and stops a signed-in
      // stranger with no bridge doc from dumping the whole staff directory.
      //
      // The own-doc clause is what an `invited` person reads on the setup screen:
      // since createEmployeeAccount mints the Auth account up front, their doc has
      // carried `uid` since creation.
      allow read: if isAdmin()
        || (isActiveUser() && resource.data.status == 'active')
        || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isAdmin()
            && !request.resource.data.keys()
                 .hasAny(['uid', 'termsAcceptedAt', 'locationConsentAt',
                          'emergencyContact', 'emergencyPhone'])
            && isValidUserData(request.resource.data);

      // Rejects a colorValue write that isn't a valid integer string — otherwise a bad
      // value could sneak through and the client would silently fall back to the
      // default blue.
      function isValidColorValue(s) {
        return s is string && s.matches('^-?[0-9]+$');
      }

      // Keeps role and status limited to the allowlist, so a compromised admin
      // session can't mint a bogus role or throw the usersByUid bridge out of sync.
      function isValidRole(r) {
        return r in ['admin', 'employee'];
      }
      function isValidUserStatus(s) {
        return s in ['active', 'disabled', 'invited'];
      }

      function isValidJobTitle(t) {
        return t is string
          && t in ['', 'lead_tech', 'technician', 'apprentice', 'dispatcher'];
      }
      function isMinuteOfDay(v) {
        return v is int && v >= 0 && v <= 1440;
      }

      // Rules cannot iterate a list, so the element type is not provable here —
      // the length and list-ness are the enforceable half, and every write path
      // builds the list from seven bools.
      function isValidWorkingDays(v) {
        return v is list && v.size() == 7;
      }

      function isValidUserData(d) {

        return (!('name' in d.keys()) || isBoundedString(d.name, 250))
          && (!('firstName' in d.keys()) || isBoundedString(d.firstName, 200))
          && (!('lastName' in d.keys()) || isBoundedString(d.lastName, 200))
          && (!('email' in d.keys()) || isBoundedString(d.email, 320))
          && (!('phone' in d.keys()) || isBoundedString(d.phone, 40))

          && (!('emergencyContact' in d.keys())
              || isBoundedString(d.emergencyContact, 200))
          && (!('emergencyPhone' in d.keys())
              || isBoundedString(d.emergencyPhone, 40))
          && (!('jobTitle' in d.keys()) || isValidJobTitle(d.jobTitle))
          && (!('workingDays' in d.keys()) || isValidWorkingDays(d.workingDays))
          && (!('workStartMinutes' in d.keys())
              || isMinuteOfDay(d.workStartMinutes))
          && (!('workEndMinutes' in d.keys())
              || isMinuteOfDay(d.workEndMinutes))
          && (!('maxJobsPerDay' in d.keys())
              || (d.maxJobsPerDay is int
                  && d.maxJobsPerDay >= 0
                  && d.maxJobsPerDay <= 50))
          && (!('onCall' in d.keys()) || d.onCall is bool)
          // Per-person opt-out for the "time to leave" push. ABSENT means ON —
          // every doc written before this field existed has no value, and the
          // sweep reads undefined as enabled. See wantsTravelAlerts.
          && (!('travelAlertsEnabled' in d.keys())
              || d.travelAlertsEnabled is bool)
          && (!('locationSharingEnabled' in d.keys())
              || d.locationSharingEnabled is bool)
          && (!('colorValue' in d.keys()) || isValidColorValue(d.colorValue))
          && (!('role' in d.keys()) || isValidRole(d.role))
          && (!('status' in d.keys()) || isValidUserStatus(d.status))

          && (!('termsAcceptedAt' in d.keys())
              || d.termsAcceptedAt is timestamp)
          && (!('locationConsentAt' in d.keys())
              || d.locationConsentAt is timestamp);
      }

      function emergencyFieldNotSet(f) {
        return !request.resource.data.diff(resource.data)
                  .affectedKeys().hasAny([f])
            || !(f in request.resource.data);
      }

      function isSelf() {
        return isActiveUser()
          && resource.data.uid == request.auth.uid;
      }

      function isAvailabilityOnlyChange() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['workingDays', 'workStartMinutes', 'workEndMinutes',
                      'onCall', 'phone', 'travelAlertsEnabled',
                      'locationSharingEnabled', 'updatedAt'])
          && request.resource.data.updatedAt == request.time;
      }

      function emailMovesThroughAuth() {
        return !request.resource.data.diff(resource.data)
                  .affectedKeys().hasAny(['email'])
            || !('uid' in resource.data)
            || resource.data.uid == '';
      }


      allow update: if (isAdmin() || (isSelf() && isAvailabilityOnlyChange()))
            && !request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(['uid', 'termsAcceptedAt', 'locationConsentAt',
                          'setupRequiresPassword'])
            && emailMovesThroughAuth()
            && emergencyFieldNotSet('emergencyContact')
            && emergencyFieldNotSet('emergencyPhone')
            && isValidUserData(request.resource.data);

      match /private/emergency {
        allow read: if isAdmin() || (isActiveUser() && myDocId() == userId);
        allow write: if (isAdmin() || (isActiveUser() && myDocId() == userId))
          && request.resource.data.keys()
               .hasOnly(['contact', 'phone', 'updatedAt'])
          && (!('contact' in request.resource.data.keys())
              || isBoundedString(request.resource.data.contact, 200))
          && (!('phone' in request.resource.data.keys())
              || isBoundedString(request.resource.data.phone, 40))
          && (!('updatedAt' in request.resource.data.keys())
              || request.resource.data.updatedAt is timestamp);
      }

      // FCM device tokens — a user can only read or write their own, and writes are
      // shape-constrained so nobody can plant a token under a spoofed identity.
      match /fcmTokens/{token} {
        allow read, delete: if isActiveUser() && myDocId() == userId;
        allow create, update: if isActiveUser()
          && myDocId() == userId
          && request.resource.data.keys().hasOnly(
              ['platform', 'locale', 'uid', 'createdAt', 'updatedAt'])
          && request.resource.data.locale in ['en', 'fr']
          && request.resource.data.platform in ['ios', 'android']
          && request.resource.data.uid == request.auth.uid
          && (!('createdAt' in request.resource.data.keys())
              || request.resource.data.createdAt is timestamp)
          && (!('updatedAt' in request.resource.data.keys())
              || request.resource.data.updatedAt is timestamp);
      }

      // Live Activity tokens — same self-only rule as fcmTokens, iOS-only, keyed by
      // the ActivityKit activity id or the literal `pushToStart`.
      match /liveActivityTokens/{activityId} {
        allow read, delete: if isActiveUser() && myDocId() == userId;
        allow create, update: if isActiveUser()
          && myDocId() == userId
          // No `appointmentId` here — that association lives server-side in
          // liveActivityCards, since the device can't read back ActivityKit attributes.
          && request.resource.data.keys().hasOnly(
              ['token', 'kind', 'employeeDocId', 'platform',
               'locale', 'uid', 'createdAt', 'updatedAt', 'expiresAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 500
          && request.resource.data.kind in ['pushToStart', 'update']
          && request.resource.data.locale in ['en', 'fr']
          && request.resource.data.platform in ['ios']
          && request.resource.data.uid == request.auth.uid
          && (!('employeeDocId' in request.resource.data.keys())
              || request.resource.data.employeeDocId == userId)
          && (!('createdAt' in request.resource.data.keys())
              || request.resource.data.createdAt is timestamp)
          && (!('updatedAt' in request.resource.data.keys())
              || request.resource.data.updatedAt is timestamp)
          // This has to be required: the TTL policy and pruneExpiredActivityTokens both
          // key on it, and Firestore skips docs that are missing the field — so an
          // optional value would let a client mint rows nothing could ever clean up.
          // We cap it just above liveActivityPushToStartTtl (30d) so a client can't write
          // an expiry that outlives the sweep — raise both together if that changes.
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt
             < request.time + duration.value(31, 'd');
      }

      // Live-location presence for travel-time reminders. Owners can only touch their
      // own doc here — admins read everything via the collectionGroup rule below.
      // `updatedAt == request.time` forces serverTimestamp(), so a client can't fake
      // freshness by writing a future timestamp.
      match /presence/{presenceId} {
        allow read, delete: if isActiveUser() && myDocId() == userId;
        allow create, update: if isActiveUser()
          && myDocId() == userId
          && presenceId == 'location'
          && request.resource.data.keys().hasOnly(
              ['lat', 'lng', 'updatedAt', 'uid'])
          && request.resource.data.lat is number
          && request.resource.data.lat >= -90
          && request.resource.data.lat <= 90
          && request.resource.data.lng is number
          && request.resource.data.lng >= -180
          && request.resource.data.lng <= 180
          && request.resource.data.updatedAt == request.time
          && request.resource.data.uid == request.auth.uid;
      }
    }

    // ── presence (admin live-map read) ───────────────────────────────────
    // Gives admins read access (get + list, including collectionGroup) over every
    // presence subcollection — the nested rule above still governs what an owner can
    // do. isAdmin() only checks the caller, which is what keeps this unfiltered
    // collection-group query provable. Note that {path=**} reserves the `presence`
    // subcollection name for any future collection too.
    match /{path=**}/presence/{presenceId} {
      allow read: if isAdmin();
    }

    // ── appointments ──────────────────────────────────────────────────────────
    // The lifecycle goes pending -> in_progress -> done, plus cancelled. Employees
    // can only ever write 'done' (see below).
    function isValidAppointmentStatus(s) {
      return s in ['pending', 'in_progress', 'done', 'cancelled'];
    }

    function isValidDocIdField(v) {
      return v is string && v.size() <= 128 && !v.matches('.*/.*');
    }

    // Empty client links are used by personal jobs. Existing history remains
    // editable; only creating or changing a link needs an available client.
    function canLinkClient(d) {
      let id = d.get('clientId', '');
      return id == '' || (isValidDocIdField(id)
        && getAfter(/databases/$(database)/documents/clients/$(id))
             .data.get('deletionToken', '') == '');
    }

    function isValidAppointmentSpan(d) {
      return !('startTime' in d.keys()) || !('endTime' in d.keys())
        || (d.startTime is timestamp
            && d.endTime is timestamp
            && d.endTime >= d.startTime
            && d.endTime - d.startTime
                 <= duration.value(14, 'd') + duration.value(2, 'h'));
    }

    function appointmentSpanNotWidened() {
      return resource.data.startTime is timestamp
        && resource.data.endTime is timestamp
        && request.resource.data.endTime - request.resource.data.startTime
           <= resource.data.endTime - resource.data.startTime;
    }

    function hasValidAppointmentInstants(d) {
      return (!('startTime' in d.keys()) || d.startTime is timestamp)
        && (!('endTime' in d.keys()) || d.endTime is timestamp);
    }

    function isValidAppointmentData(d) {
      return (!('title' in d.keys()) || isBoundedString(d.title, 200))
        // The one string `toMap()` emits that had no cap. It is an enum name
        // client-side, so this is far above anything legitimate.
        && (!('repeat' in d.keys()) || isBoundedString(d.repeat, 32))
        && (!('address' in d.keys()) || isBoundedString(d.address, 500))
        && (!('notes' in d.keys()) || isBoundedString(d.notes, 4000))
        && (!('fieldNotes' in d.keys()) || isBoundedString(d.fieldNotes, 4000))
        // Type checks only; the write ban lives at the create/update rules.
        && (!('startedAt' in d.keys()) || d.startedAt is timestamp)
        && (!('completedAt' in d.keys()) || d.completedAt is timestamp)
        && (!('materialsNeeded' in d.keys())
            || isBoundedString(d.materialsNeeded, 2000))

        && (!('clientName' in d.keys()) || isBoundedString(d.clientName, 401))
        && (!('clientPhone' in d.keys()) || isBoundedString(d.clientPhone, 40))
        && (!('clientId' in d.keys()) || isValidDocIdField(d.clientId))
        && (!('seriesId' in d.keys()) || isValidDocIdField(d.seriesId))
        // Same reasoning as the ids above: `seriesOpId` is interpolated into
        // the `appointmentSeriesNotices/op_<opId>_<kind>_<emp>` doc id.
        && (!('seriesOpId' in d.keys()) || isValidDocIdField(d.seriesOpId))

        && (!('pictures' in d.keys())
            || (d.pictures is list && d.pictures.size() <= 100))

        && (!('employeeIds' in d.keys())
            || (d.employeeIds is list && d.employeeIds.size() <= 500))
        && (!('employeeNames' in d.keys())
            || (d.employeeNames is list && d.employeeNames.size() <= 500))
        && (!('historySearchScopes' in d.keys())
            || (d.historySearchScopes is list
                && d.historySearchScopes.size() <= 240))

        && (!('dayIndex' in d.keys())
            || (d.dayIndex is int && d.dayIndex >= 1 && d.dayIndex <= 14))
        && (!('dayCount' in d.keys())
            || (d.dayCount is int && d.dayCount >= 1 && d.dayCount <= 14));
    }

    match /appointments/{appointmentId} {
      function parentAppointment() {
        return get(/databases/$(database)/documents/appointments/$(appointmentId)).data;
      }

      // Read: admin sees all; assigned employee sees their appointments.
      allow read: if isAdmin() || isAssignedEmployee(resource.data);

      allow create: if isAdmin()
        && canLinkClient(request.resource.data)
        && (!('pictureCount' in request.resource.data.keys())
            || request.resource.data.pictureCount == 0)
        && !request.resource.data.keys().hasAny(['startedAt', 'completedAt'])
        && isValidAppointmentStatus(request.resource.data.status)
        && isValidAppointmentData(request.resource.data)
        // No existing doc to strand, so the span bound and the per-instant
        // type checks are both outright here.
        && hasValidAppointmentInstants(request.resource.data)
        && isValidAppointmentSpan(request.resource.data);

      allow update: if (isAdmin()
            && (request.resource.data.get('clientId', '') == resource.data.get('clientId', '')
                || canLinkClient(request.resource.data))
            && !request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(['pictureCount', 'startedAt', 'completedAt'])
            && isValidAppointmentStatus(request.resource.data.status)
            && isValidAppointmentData(request.resource.data)
            && (isValidAppointmentSpan(request.resource.data)
                || appointmentSpanNotWidened()))
        || (isAssignedEmployee(resource.data)
            && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'done'

            && request.resource.data.updatedAt == request.time
            && resource.data.status != 'cancelled')

        || (isAssignedEmployee(resource.data)
            && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['fieldNotes', 'updatedAt'])
            && (!('fieldNotes' in request.resource.data)
                || isBoundedString(request.resource.data.fieldNotes, 4000))
            && request.resource.data.updatedAt == request.time)
        // "Start job": the assignee moves an open job FORWARD into
        // `in_progress`, and nothing else. Its own branch, not a widening of
        // the mark-done one: that branch's `status == 'done'` is its whole
        // guarantee, and admitting a second value there would let one write
        // do either. This one can only ever go from an open status into
        // in-progress — never backwards, never out of a closed state, and
        // never twice (a re-tap is refused rather than re-stamped). The
        // `startedAt` instant itself is stamped SERVER-SIDE by the write
        // trigger (`lifecycleStamps`), so no client may write it here.
        || (isAssignedEmployee(resource.data)
            && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'in_progress'
            && request.resource.data.updatedAt == request.time
            && !(resource.data.status in
                ['in_progress', 'done', 'completed', 'cancelled']));

      // Delete: admin only.
      allow delete: if isAdmin();

      // ── appointments/{id}/images ────────────────────────────────────────

      match /images/{imageId} {
        allow read: if isAdmin() || isAssignedEmployee(parentAppointment());

        allow create: if (isAdmin() || isAssignedEmployee(parentAppointment()))
          && request.resource.data.keys().hasOnly(
              ['storagePath', 'fileName', 'uploadedAt'])
          && isBoundedString(request.resource.data.storagePath, 500)
          && request.resource.data.storagePath.matches(
              'appointments/' + appointmentId + '/images/.*')
          && (!('fileName' in request.resource.data.keys())
              || isBoundedString(request.resource.data.fileName, 300))
          && (!('uploadedAt' in request.resource.data.keys())
              || request.resource.data.uploadedAt == null
              || request.resource.data.uploadedAt is timestamp);

        allow update: if isAdmin()
          && request.resource.data.keys().hasOnly(
              ['storagePath', 'fileName', 'uploadedAt'])
          && isBoundedString(request.resource.data.storagePath, 500)
          && request.resource.data.storagePath.matches(
              'appointments/' + appointmentId + '/images/.*')
          && (!('fileName' in request.resource.data.keys())
              || isBoundedString(request.resource.data.fileName, 300))
          && (!('uploadedAt' in request.resource.data.keys())
              || request.resource.data.uploadedAt == null
              || request.resource.data.uploadedAt is timestamp);

        allow delete: if isAdmin();
      }

      match /fieldNotes/{noteId} {
        allow read: if isAdmin() || isAssignedEmployee(parentAppointment());

        allow create: if (isAdmin() || isAssignedEmployee(parentAppointment()))
          && request.resource.data.keys().hasOnly(
              ['text', 'authorId', 'authorName', 'createdAt'])
          && isBoundedString(request.resource.data.text, 4000)
          && request.resource.data.text.size() > 0
          && request.resource.data.authorId == myDocId()
          && isBoundedString(request.resource.data.authorName, 250)
          && request.resource.data.createdAt == request.time;

        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ── clients ───────────────────────────────────────────────────────────────
    // This is all client PII, so it's admin-only — employees never need direct
    // access to it.
    function isValidClientData(data) {
      // 225, NOT the 200 the name FIELD is capped at. The stored `name` is the
      // typed name PLUS the client's phone number — that field is synced
      // verbatim as the Wave customer name (see ClientNamePolicy), so the
      // widest value a shipped write path can produce is
      // TextLimits.personName (200) + one space + TextLimits.phone (24).
      // A cap sized to the typed field alone rejects every long client save
      // with an opaque `permission-denied`. Pinned by text_limits_test.dart.
      return (!('name' in data) || (data.name is string && data.name.size() <= 225))
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 200))
        && (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 200))
        && (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 32))
        && (!('email' in data) || (data.email is string && data.email.size() <= 320))
        // 533, not 500: both client sheets store `AddressParser.canonicalFrom`,
        // which combines the 500-char street field with the 32-char apt field
        // and a separator. Same reasoning as `clientName` on appointments.
        && (!('address' in data) || (data.address is string && data.address.size() <= 533))
        // Written ONLY by the Wave import, which uses the Admin SDK and so
        // bypasses these rules — but `ClientRecord.toMap()` neither reads nor
        // emits it, so it rides along untouched in `request.resource.data` on
        // every ordinary in-app save and this cap can reject one. 500, the
        // same as `IMPORT_FIELD_CAPS.addressLine2`: Wave's `addressLine2` is a
        // peer street line of `addressLine1`, not the app's separate 64-char
        // `apt` field.
        && (!('addressLine2' in data) || (data.addressLine2 is string && data.addressLine2.size() <= 500))
        && (!('apt' in data) || (data.apt is string && data.apt.size() <= 64))
        && (!('city' in data) || (data.city is string && data.city.size() <= 128))
        && (!('province' in data) || (data.province is string && data.province.size() <= 128))
        && (!('country' in data) || (data.country is string && data.country.size() <= 128))
        && (!('postalCode' in data) || (data.postalCode is string && data.postalCode.size() <= 32))
        // Known gap: rules can't cap the length of each contact's fields, only how
        // many contacts there are. So an admin write can still reach Firestore's 1 MB
        // ceiling and fan out via propagateClientEdits — we've accepted that since
        // it's admin-only. The real fix is a per-field TextLimits cap in the contacts
        // editor, not tightening this array-length number.
        && (!('contacts' in data) || (data.contacts is list && data.contacts.size() <= 50))
        && (!('type' in data) || (data.type is string && data.type.size() <= 32))
        && (!('accessNotes' in data) || (data.accessNotes is string && data.accessNotes.size() <= 500))
        && (!('onSiteManager' in data) || (data.onSiteManager is string && data.onSiteManager.size() <= 200))
        && (!('billingTerms' in data) || (data.billingTerms is string && data.billingTerms.size() <= 200))
        && (!('autoInvoice' in data) || data.autoInvoice is bool)
        && (!('noFixedAddress' in data) || data.noFixedAddress is bool)
        && (!('archived' in data) || data.archived is bool)
        && (!('searchTokens' in data)
            || (data.searchTokens is list && data.searchTokens.size() <= 240));
    }

    match /clients/{clientId} {
      allow read: if isAdmin();
      // `waveCustomerId` and `wave` are written only by Cloud Functions via the
      // Admin SDK, which bypasses these rules entirely. The client app should never
      // touch these fields, so we reject any create that includes them.
      // `jobCount` is likewise function-owned — recountClientJobs writes it as an
      // absolute count() aggregate, so a client write must never touch it.
      allow create: if isAdmin()
        && isValidClientData(request.resource.data)
        && !request.resource.data.keys().hasAny(['deletionToken', 'buildingKey'])
        && !('waveCustomerId' in request.resource.data.keys())
        && !('wave' in request.resource.data.keys())
        && !('jobCount' in request.resource.data.keys());
      // On updates we only reject if the client is trying to change or add the Wave
      // fields — an update that leaves them alone has no affected keys, so it's fine.
      allow update: if isAdmin()
        && isValidClientData(request.resource.data)
        && resource.data.get('deletionToken', '') == ''
        && !request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasAny(['waveCustomerId', 'wave', 'jobCount', 'deletionToken', 'buildingKey']);
      // No delete grant, deliberately. Delete belongs to the `deleteClient`
      // callable, which refuses a client that still has appointments. Rules
      // cannot express "only when this client has no appointments" — there is
      // no cheap way to count a foreign collection here — so the callable is
      // the only place that guarantee can live, and nothing may delete a client
      // directly. The 1.37.1 compat grant that kept this open (for that build's
      // ungated Delete button) retired 2026-08-08; don't restore it.
    }

    match /clientBuildings/{buildingId} {
      allow read: if isAdmin();
    }

    // ── wave (Wave Accounting connection metadata) ────────────────────────────
    // Only Cloud Functions write here, via the Admin SDK — connection status,
    // businessId, last-sync timestamps. The access token itself lives only in Secret
    // Manager, never here. No client can read connection state; treat this like
    // rateLimits.
    match /wave/{docId} {
      allow read, write: if false;
    }

    // ── waveSyncQueue (outbox for Wave API sync jobs) ─────────────────────────
    // Cloud Functions enqueue and process these jobs via the Admin SDK. No client
    // can read pending jobs, inspect retry state, or reset the queue — that could
    // expose Wave API credentials sitting in job payloads, or let a client cancel
    // or replay a sync.
    match /waveSyncQueue/{jobId} {
      allow read, write: if false;
    }
  }
}
